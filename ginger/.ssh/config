# Ginger dev boxes over Tailscale (dotfiles `ginger` package).
# One shared connection per box: the first `ssh rz` pays the handshake, later
# ones (scp, git, mosh, the Ginger menu refresh) reuse it for 10 minutes.
# `dev` passes its own ControlPath, so it keeps its own shared connection; the
# keepalive and compression below still apply to it, matched by IP.
# Host keys come from ginger-dev's boxes.toml (`dev` keeps them in known_hosts).

Host rz 100.70.80.22
  HostName 100.70.80.22

Host pi rutty-pi 100.96.195.122
  HostName 100.96.195.122

Host rz pi rutty-pi 100.70.80.22 100.96.195.122
  User ruttydm
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  ServerAliveInterval 30
  ServerAliveCountMax 4
  Compression yes
  UserKnownHostsFile ~/.ssh/known_hosts ~/.config/ginger-dev/known_hosts
