#!/usr/bin/env bash
# Enable SSH from other devices on this Tailscale tailnet.
# Port 22 is opened on tailscale0 only, not on public Wi-Fi or LAN.
#
# Prefers Tailscale SSH (identity, no keys). If this node never advertises
# SSH host keys, fall back to OpenSSH bound to the Tailscale addresses.
set -euo pipefail

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

as_root() {
  if ((EUID == 0)); then
    "$@"
  else
    sudo "$@"
  fi
}

ssh_banner() {
  local host=$1
  python3 - "$host" <<'PY'
import socket, sys
host = sys.argv[1]
s = socket.socket()
s.settimeout(3)
try:
    s.connect((host, 22))
    data = s.recv(120)
    sys.stdout.write(data.decode("latin1", "replace").strip())
except Exception:
    sys.exit(1)
finally:
    s.close()
PY
}

tailscale_ssh_hostkeys() {
  tailscale status --json | python3 -c 'import json,sys
d=json.load(sys.stdin)
hi=(d.get("Self") or {}).get("Hostinfo") or {}
keys=hi.get("sshHostKeys") or []
sys.exit(0 if keys else 1)'
}

if ! need_cmd tailscale; then
  echo "tailscale is not installed. On Omarchy: omarchy install service tailscale" >&2
  exit 1
fi

if ! tailscale status >/dev/null 2>&1; then
  echo "Tailscale is installed but not logged in. Run: tailscale up --accept-routes --ssh" >&2
  exit 1
fi

echo "Enabling Tailscale SSH..."
tailscale set --ssh

ip4=$(tailscale ip -4)
ip6=$(tailscale ip -6 2>/dev/null || true)
dns=$(tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')
user=${SUDO_USER:-${USER:-$(id -un)}}
mode=none

if need_cmd ufw; then
  echo "Allowing TCP/22 on tailscale0 only..."
  as_root ufw allow in on tailscale0 to any port 22 proto tcp comment 'tailscale-ssh' >/dev/null
  as_root ufw reload >/dev/null
fi

if tailscale_ssh_hostkeys; then
  mode=tailscale
else
  echo "Tailscale SSH pref is on, but this node is not advertising host keys."
  echo "Starting OpenSSH on the Tailscale addresses only..."
  as_root ssh-keygen -A >/dev/null
  as_root tee /etc/ssh/sshd_config.d/50-tailscale-only.conf >/dev/null <<CONF
# Written by enable-tailscale-ssh — SSH only on the Tailscale addresses.
ListenAddress ${ip4}
${ip6:+ListenAddress ${ip6}}
CONF
  if ! as_root sshd -t; then
    as_root rm -f /etc/ssh/sshd_config.d/50-tailscale-only.conf
    echo "sshd rejected the Tailscale-only listen config" >&2
    exit 1
  fi
  as_root systemctl enable --now sshd.service
  as_root systemctl reload sshd.service 2>/dev/null || as_root systemctl restart sshd.service
  sleep 1
  mode=openssh
fi

banner=$(ssh_banner "$ip4" || true)
if [[ -z $banner ]]; then
  echo "Nothing is accepting SSH on ${ip4}:22." >&2
  exit 1
fi

echo "Listening: $banner ($mode)"
echo "From another Tailscale device:"
echo "  ssh ${user}@${dns}"
echo "  ssh ${user}@${ip4}"
if [[ $mode == openssh ]]; then
  echo
  echo "Log in as ${user} with this machine's Linux password, or add the"
  echo "other device's public key to ~${user}/.ssh/authorized_keys."
  echo "SSH is bound to Tailscale only; public Wi-Fi is not opened."
fi
