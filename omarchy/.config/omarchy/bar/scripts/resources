#!/usr/bin/env python3
"""CPU and memory readout for the Omarchy status bar.

Prints one Waybar-style JSON line: a chip icon with CPU percent and a
memory-stick icon with RAM percent. Samples /proc/stat across a short
gap so the CPU figure is a real delta, not the since-boot average.
"""

import json
import time
from pathlib import Path

# These private-use glyphs render opposite their usual names in JetBrainsMono Nerd Font:
# U+F2DB is the pin-grid chip, U+F061A is the memory stick.
CPU_ICON = "\U0000f2db"
RAM_ICON = "\U000f061a"


def cpu_sample():
    parts = Path("/proc/stat").read_text().splitlines()[0].split()
    numbers = [int(part) for part in parts[1:9]]
    idle = numbers[3] + numbers[4]
    return sum(numbers), idle


def memory():
    info = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        key, value = line.split(":", 1)
        info[key] = int(value.split()[0])
    total = info.get("MemTotal", 0)
    available = info.get("MemAvailable", 0)
    used = max(0, total - available)
    percent = round(used * 100 / total) if total else 0
    return percent, used, total


def main():
    total1, idle1 = cpu_sample()
    time.sleep(0.25)
    total2, idle2 = cpu_sample()
    delta = total2 - total1
    cpu = round((delta - (idle2 - idle1)) * 100 / delta) if delta else 0
    cpu = max(0, min(100, cpu))

    ram, used_kb, total_kb = memory()
    text = f"{CPU_ICON} {cpu:3d}%  {RAM_ICON} {ram:3d}%"
    tooltip = f"CPU {cpu}%\nMemory {used_kb / 1048576:.1f} / {total_kb / 1048576:.1f} GiB"
    print(json.dumps({"text": text, "tooltip": tooltip}, ensure_ascii=False))


if __name__ == "__main__":
    main()
