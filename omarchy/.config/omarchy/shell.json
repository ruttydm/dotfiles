{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "ruttydm.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "ruttydm.clock",
          "format": "dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm\n—\nss",
          "compareTimezone": "Europe/Brussels",
          "compareLabel": "BRU"
        },
        {
          "id": "io.github.ruttydm.nimbus"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.ruttydm.felt-poker"
        },
        {
          "id": "huacnlee.which-key"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "njpatel.omaherdr",
          "barIcon": "dashboard"
        },
        {
          "id": "omarchy.agents",
          "providers": {
            "claude": { "enabled": true },
            "codex": { "enabled": true },
            "fireworks": { "enabled": false }
          }
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "ruttydm.tailnet"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "omarchy-spacexai-usage"
    }
  ]
}
