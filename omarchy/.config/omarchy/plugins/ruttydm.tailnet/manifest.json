{
  "schemaVersion": 1,
  "id": "ruttydm.tailnet",
  "name": "Tailnet stats",
  "version": "1.1.0",
  "author": "ruttydm",
  "description": "CPU and memory for this machine, then each fleet box's health and T3 agents on the bar; click for every device on the tailnet.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Tailnet stats",
    "description": "This machine's CPU and memory, a pill per server and dev box with its agents (urgent when a box is down or full); the dropdown lists every tailnet device.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshSeconds": 15,
      "pollSeconds": 60
    },
    "schema": [
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Refresh while open (seconds)",
        "min": 10,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "pollSeconds",
        "type": "integer",
        "label": "Fleet check while closed (seconds)",
        "min": 30,
        "max": 600,
        "step": 10,
        "defaultValue": 60
      }
    ]
  }
}
